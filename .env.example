APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Python Configuration for RuteStrip
PYTHON_PATH=python
# Persistent SBERT processor (keeps the model in memory). On the VPS it is served
# by webchat-api at /processor. Leave empty to run python/processor.py per request.
PYTHON_PROCESSOR_URL=

# Google Gemini API Key for RAG Chatbot
GEMINI_API_KEY=
# "Asisten RuteStrip" widget (AssistantController): model order. GEMINI_MODELS (comma list)
# wins; otherwise GEMINI_MODEL then GEMINI_FALLBACK_MODELS (default gemini-3.5-flash,gemini-3.1-flash-lite).
# Timeouts in milliseconds (defaults 12000 first token, 30000 total). Uncomment to set.
# GEMINI_MODEL=
# GEMINI_MODELS=
# GEMINI_FALLBACK_MODELS=
# GEMINI_FIRST_TOKEN_TIMEOUT_MS=
# GEMINI_TOTAL_TIMEOUT_MS=


# Public AI webchat (navbar "AI Chat" link)
WEBCHAT_URL=https://chat.rutestrip.ai.id

# Admin account for "php artisan db:seed --class=AdminSeeder" (random password if empty)
ADMIN_EMAIL=admin@rutestrip.ai.id
ADMIN_PASSWORD=

# Anti-robot check on /register (self-hosted ALTCHA proof-of-work).
# Generate with: php -r "echo bin2hex(random_bytes(32));"  (empty = derived from APP_KEY)
ALTCHA_HMAC_KEY=
# Upper bound of the secret number; higher = slower to solve (default 100000)
ALTCHA_MAX_NUMBER=100000

# Single sign-on with the web chat (docs/SSO.md). RUTESTRIP_SSO_SECRET must match
# webchat/.env.local and webchat-api/.env; RUTESTRIP_INTERNAL_SECRET must match webchat/.env.local.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Production: SSO_COOKIE_DOMAIN=.rutestrip.ai.id and SSO_COOKIE_SECURE=true (empty locally).
RUTESTRIP_SSO_SECRET=
RUTESTRIP_INTERNAL_SECRET=
SSO_COOKIE_DOMAIN=
SSO_COOKIE_SECURE=

# Search engine ownership verification (meta tags)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
