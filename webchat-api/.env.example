# RuteStrip Webchat API (FastAPI) environment template.
# Load with systemd EnvironmentFile= or export before running uvicorn.

POSTGRES_DB=rutestrip
POSTGRES_USER=rutestrip_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Single sign-on with rutestrip.ai.id (docs/SSO.md). Accounts live in Laravel.
# Same value as RUTESTRIP_SSO_SECRET in Laravel .env and webchat/.env.local.
RUTESTRIP_SSO_SECRET=
# Laravel base URL used to confirm tokens (GET /api/sso/me, cached 5 min per token).
# Production: https://rutestrip.ai.id   Local: http://127.0.0.1:8000
LARAVEL_URL=https://rutestrip.ai.id
# Timeout (seconds) for that confirmation call
SSO_CONFIRM_TIMEOUT=3

# Only needed by the Telegram broadcast helpers. Leave empty for webchat-only use.
RUTESTRIP_BOT_TOKEN=
