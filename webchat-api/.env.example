# RuteStrip Webchat API (FastAPI) environment template.
# Load with systemd EnvironmentFile= or export before running uvicorn.

POSTGRES_DB=rutestrip
POSTGRES_USER=rutestrip_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Anti-robot check (self-hosted ALTCHA proof-of-work) on webchat registration.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a key is derived from POSTGRES_PASSWORD (warning logged).
ALTCHA_HMAC_KEY=
# Upper bound of the secret number; higher = slower to solve (default 100000)
ALTCHA_MAX_NUMBER=100000

# Only needed by the Telegram broadcast helpers. Leave empty for webchat-only use.
RUTESTRIP_BOT_TOKEN=
